{
  "name": "narrant",
  "private": true,
  "version": "1.2.10",
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=22.13 <26"
  },
  "scripts": {
    "generate:file-icons": "node scripts/generate-file-type-icons.mjs",
    "release:prepare": "node scripts/release-prepare.mjs",
    "predev": "pnpm generate:file-icons",
    "dev": "vite --host 127.0.0.1 --port 1420",
    "predev:preview": "pnpm generate:file-icons",
    "dev:preview": "vite --host 127.0.0.1 --port 1421 --open /preview.html",
    "prebuild": "pnpm generate:file-icons",
    "build": "tsc --noEmit && cross-env NODE_OPTIONS=--max-old-space-size=4096 vite build",
    "build:macos": "pnpm tauri build --bundles dmg",
    "build:macos:signed": "bash scripts/build-macos-signed.sh",
    "build:windows": "pnpm tauri build --bundles nsis",
    "lint": "eslint .",
    "test": "vitest run",
    "test:components": "vitest run",
    "test:e2e": "cross-env VITE_WDIO=true pnpm tauri build --debug --no-bundle --features wdio --config src-tauri/tauri.e2e.conf.json && wdio run wdio.conf.ts",
    "test:e2e:custom-live": "node scripts/run-live-custom-provider-e2e.mjs",
    "tauri": "node scripts/run-tauri.mjs",
    "clean:tauri": "scripts/cargo-agent.sh clean --manifest-path src-tauri/Cargo.toml",
    "rust:cache:status": "node scripts/rust-cache.mjs status",
    "rust:cache:clean": "node scripts/rust-cache.mjs clean",
    "test:scripts": "node --test scripts/tests/*.test.mjs",
    "td": "pnpm tauri dev"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/oxanium": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.2.3",
    "@hugeicons/react": "^1.1.9",
    "@monaco-editor/react": "^4.7.0",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^26.3.6",
    "material-icon-theme": "^5.37.0",
    "monaco-editor": "0.55.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.11",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.2",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "shadcn": "^4.13.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.1.0",
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "4.1.10",
    "@wdio/cli": "9.27.1",
    "@wdio/local-runner": "9.27.1",
    "@wdio/mocha-framework": "9.27.1",
    "@wdio/native-utils": "2.5.0",
    "@wdio/tauri-plugin": "^1.2.0",
    "@wdio/tauri-service": "^1.2.0",
    "cross-env": "^7.0.3",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "expect-webdriverio": "^5.0.0",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.64.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.10",
    "webdriverio": "9.27.1"
  }
}
