# LLVM 21.1.8 的 Windows 包把构建机 DIA 库绝对路径导出在 LLVMDebugInfoPDB 上。
# 来源：https://github.com/llvm/llvm-project/blob/llvmorg-21.1.8/llvm/lib/DebugInfo/PDB/CMakeLists.txt
# 只修改当前配置中的导入目标，不修改固定 SDK 的任何文件。
function(narrant_relocate_windows_dia visual_studio_root)
  if("${visual_studio_root}" STREQUAL "")
    message(FATAL_ERROR "A fixed CMAKE_GENERATOR_INSTANCE is required for the VS2022 DIA library")
  endif()
  string(REPLACE "\\" "/" _narrant_vs_root "${visual_studio_root}")
  set(_narrant_dia "${_narrant_vs_root}/DIA SDK/lib/amd64/diaguids.lib")
  if(NOT EXISTS "${_narrant_dia}" OR IS_DIRECTORY "${_narrant_dia}")
    message(FATAL_ERROR "Required VS2022 DIA library is missing: ${_narrant_dia}")
  endif()
  if(NOT TARGET LLVMDebugInfoPDB)
    message(FATAL_ERROR "The fixed LLVM 21.1.8 SDK must export LLVMDebugInfoPDB")
  endif()

  set(_narrant_upstream_dia "C:/Program Files (x86)/Microsoft Visual Studio/2019/Professional/DIA SDK/lib/amd64/diaguids.lib")
  get_target_property(_narrant_links LLVMDebugInfoPDB INTERFACE_LINK_LIBRARIES)
  set(_narrant_updated_links)
  set(_narrant_replacements 0)
  foreach(_narrant_link IN LISTS _narrant_links)
    string(REPLACE "\\" "/" _narrant_normalized_link "${_narrant_link}")
    if(_narrant_normalized_link STREQUAL _narrant_upstream_dia)
      list(APPEND _narrant_updated_links "${_narrant_dia}")
      math(EXPR _narrant_replacements "${_narrant_replacements} + 1")
    else()
      list(APPEND _narrant_updated_links "${_narrant_link}")
    endif()
  endforeach()
  if(NOT _narrant_replacements EQUAL 1)
    message(FATAL_ERROR "Expected one pinned LLVM 21.1.8 DIA dependency on LLVMDebugInfoPDB; found ${_narrant_replacements}")
  endif()
  set_property(TARGET LLVMDebugInfoPDB PROPERTY INTERFACE_LINK_LIBRARIES "${_narrant_updated_links}")
  message(STATUS "Rebound LLVM 21.1.8 DIA dependency to ${_narrant_dia}")
endfunction()
