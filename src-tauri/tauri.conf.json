{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Narrant",
  "version": "0.1.0",
  "identifier": "com.narrant.app",
  "build": { "beforeDevCommand": "pnpm dev", "beforeBuildCommand": "pnpm build", "devUrl": "http://localhost:1420", "frontendDist": "../dist" },
  "app": { "withGlobalTauri": true, "windows": [{ "title": "Narrant", "width": 1100, "height": 760 }], "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline';" } },
  "bundle": { "active": true, "targets": "all", "icon": ["../assets/brand/narrant-app-icon.svg"] }
}
